# ═══════════════════════════════════════════════════════════════════════════════
# FlightScnr Pi — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# ALL configuration lives here — config.py reads exclusively from env vars.
# No defaults are hardcoded in source code for user-specific values.
#
# Setup:
#   cp .env.example .env
#   nano .env           # Fill in your values
#
# For systemd deployment, install-pi.sh copies .env to /etc/flightscnr.env
# ═══════════════════════════════════════════════════════════════════════════════
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ API Keys                                                                    │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# Required for the full experience:
#   FR24_API_KEY      — paid FR24 subscription (gRPC feed + flight details)
#   TOMORROW_API_KEY  — clock-screen weather (Tomorrow.io)
#
# Without FR24_API_KEY the app still runs on adsb.fi only (positions on radar,
# no routes/airline details/tracked flights). Set ADSB_ENABLED=True below.
# adsb.fi is a free cloud API — no local ADS-B receiver or dongle required.
#
# This is your FR24 subscription key — NOT the separate FR24 Explorer REST API.

# FlightRadar24 subscription key and token (format: "subscription_key|token")
FR24_API_KEY=

# Tomorrow.io weather API key (https://www.tomorrow.io/weather-api/)
TOMORROW_API_KEY=

# Optional — AirLabs schedule lookup when a flight is not airborne yet
#AIRLABS_API_KEY=

# Optional — aisstream.io AIS vessel feed (https://aisstream.io — free, non-commercial)
# Enable AIS data from the web portal Radar section or the on-device Settings screen.
#AISSTREAM_API_KEY=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Location (REQUIRED)                                                         │
# └─────────────────────────────────────────────────────────────────────────────┘
# Minimum setup: set HOME_LAT and HOME_LON (your coordinates).
# A search zone is auto-built using SEARCH_RADIUS_NM (default 15nm).
# Or set all four zone corners manually (north-west and south-east).
# You can also set the radar center from the web portal (saved to location.json).

HOME_LAT= 37.619664
HOME_LON= -122.372035

# Search radius in nautical miles (used when only HOME_LAT/LON are set)
SEARCH_RADIUS_NM=15

# How often to poll adsb.fi / FR24 for fresh positions (seconds)
DATA_REFRESH_SECONDS=2

# How often to merge AIS vessels into the radar display (seconds).
# The aisstream WebSocket stays connected and pushes continuously; this only
# controls how often the UI re-reads the local vessel table.
AIS_REFRESH_SECONDS=5

# Optional manual bounding box (overrides auto zone when all four are set):
#ZONE_TL_LAT=
#ZONE_TL_LON=
#ZONE_BR_LAT=
#ZONE_BR_LON=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Weather                                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# Comma-separated lat,lon for weather lookups (usually same as HOME_LAT,HOME_LON)
TEMPERATURE_LOCATION=

# Units: "metric" (°C) or "imperial" (°F). Portal weather settings override this after first save.
TEMPERATURE_UNITS=imperial

# Number of forecast days to display (1-5)
FORECAST_DAYS=3

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Display & Units                                                             │
# └─────────────────────────────────────────────────────────────────────────────┘

# Round touch display — panel resolution (rectangular framebuffer; round bezel masks corners).
# Use the native resolution of your panel; layout is centered on the visible circle.
DISPLAY_WIDTH=720
DISPLAY_HEIGHT=720

# Optional locale used only when Settings → Display → Language is set to System.
# If unset, FlightScnr reads /etc/default/locale and then LC_ALL/LC_MESSAGES/LANG.
# English remains the fallback; this does not change date order or unit settings.
#FLIGHTSCNR_SYSTEM_LOCALE=nl_NL.UTF-8

# Rotate the rendered UI clockwise: 0, 90, 180, or 270 degrees.
# Boot/default seed for Settings → Display → Rotate (and the web portal).
# After first run the value is stored in round_touch_settings.json and can be
# changed on-device without editing this file.
DISPLAY_ROTATION=90

# Fullscreen on the Pi (True/False). Set False for windowed dev on desktop.
DISPLAY_FULLSCREEN=True

# Flight detail: airline logo when no planespotters photo (True/False). Default off.
SHOW_AIRLINE_LOGOS=False

# Radar target tag size: multiplier from 0.5 to 2.0 (1.0 = default).
# Scales the callsign/type/altitude text and the tag block around it, so smaller
# tags really do take less room. Range-ring labels are unaffected.
# Anything outside the range logs a warning and falls back to 1.0.
RADAR_TAG_FONT_SCALE=1.0

# Aircraft beyond the radar range, pinned to the rim: dot | plane
# plane = the aircraft icon, pointing along its track (default)
# dot   = small half-round blip flat against the display edge
RADAR_RIM_STYLE=plane

# AIS vessel radar declutter
VESSEL_SHORT_TAGS=True
VESSEL_HIERARCHY=True
# all_labels | moving_only | icons_only
VESSEL_DENSITY_MODE=moving_only
VESSEL_PARKED_SOG_KT=0.5

# Filter stuck capacitive jitter (ghost touches) before navigation. Set false to disable.
GHOST_TOUCH_FILTER=True

# Touch event path for taps/swipes (not pinch).
# False (default): MOUSEBUTTON*/MOUSEMOTION — correct under Xwayland mouse
# emulation, and still fine on real X11 (pinch uses FINGER* either way).
# True: prefer SDL FINGER* for taps/swipes when the stack delivers them.
# If True but only mouse events arrive, the app falls back to mouse automatically.
#
# Pinch-to-zoom ALWAYS uses FINGER* when SDL provides them, regardless of this flag.
# Under pure Xwayland mouse emulation (no FINGER*), pinch cannot work — use
# Settings → Options → Range instead (GitHub issue #21).
# install-pi.sh forces the Pi OS X11 session (rpd-x) and auto-reboots when
# needed so fresh installs get real multi-touch; SDL_VIDEODRIVER=x11 is unchanged.
TOUCH_USE_FINGER_EVENTS=False

# Verbose touch logging for journalctl (leave off in normal use).
#TOUCH_DEBUG=1

# Cursor-hide diagnostics (opt-in). Watch journalctl or a log file.
#FLIGHTSCNR_CURSOR_DEBUG=1
#FLIGHTSCNR_CURSOR_LOG=/tmp/flightscnr-cursor.log

# Optional custom footer button PNGs (see flightscnr/buttons/).
# Leave unset to use the default buttons/ folder next to config.py.
#BUTTONS_DIR=/home/pi/my-button-art

# Radar map background
#RADAR_MAP_ENABLED=True
# Default basemap when settings are first created (device Options / portal override):
#RADAR_MAP_PROVIDER=dark        # CARTO dark_nolabels (default; needs CARTO_BASEMAPS_API_KEY)
#RADAR_MAP_PROVIDER=osm         # OpenStreetMap remapped to a dark radar palette (slow)
#RADAR_MAP_PROVIDER=stadia_dark # Stadia Alidade Smooth Dark (needs STADIA_MAPS_API_KEY)
#RADAR_MAP_PROVIDER=toner       # Stamen Toner B&W full style (needs Stadia key)
#RADAR_MAP_PROVIDER=satellite   # Esri World Imagery (no API key)
#RADAR_MAP_PROVIDER=streets     # Esri World Street Map — Google-like roadmap (no API key)
#RADAR_MAP_PROVIDER=black       # solid black (no tiles)
#RADAR_MAP_PROVIDER=light       # CARTO light_nolabels (needs CARTO_BASEMAPS_API_KEY)
#RADAR_MAP_PROVIDER=voyager     # CARTO Voyager (needs CARTO_BASEMAPS_API_KEY)
#RADAR_MAP_PROVIDER=vfr         # FAA VFR sectional charts (US; public domain ArcGIS tiles)
# Free CARTO key: https://carto.com/basemaps/apikey/ (dark / light / voyager)
# Can also be set in the web portal under API Keys (with Use CARTO basemaps toggle).
#CARTO_BASEMAPS_API_KEY=
# Free Stadia key: https://client.stadiamaps.com/ (only for stadia_dark / toner)
# Can also be set in the web portal under API Keys (with Use Stadia Maps toggle).
#STADIA_MAPS_API_KEY=

# SDL video driver — on Pi with legacy framebuffer + X desktop, use x11:
SDL_VIDEODRIVER=x11

# Distance: "metric" (km) or "imperial" (miles)
DISTANCE_UNITS=imperial

# Clock: "12hr" or "24hr"
CLOCK_FORMAT=24hr

# Display brightness (0-100) — used by settings screen
BRIGHTNESS=100

# Night-mode brightness (0-100, used when NIGHT_BRIGHTNESS=True)
BRIGHTNESS_NIGHT=50

# Enable night dimming? (True/False)
NIGHT_BRIGHTNESS=False

# Night mode time window (HH:MM format)
NIGHT_START=22:00
NIGHT_END=06:00

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Flight Filtering                                                            │
# └─────────────────────────────────────────────────────────────────────────────┘

# Minimum altitude in feet — aircraft below this are hidden (0 = show all including ground)
MIN_HEIGHT=1000
#MIN_ALTITUDE=1000

# Live aircraft positions from adsb.fi (free, no key, no dongle). Merges with FR24 when both are on;
# becomes the sole radar data source when FR24_API_KEY is missing or unreachable.
ADSB_ENABLED=True

# Local dump1090-fa / readsb / tar1090 JSON feed (optional). Prefer local kinematics over adsb.fi.
# Off by default — enabling with nothing on :8080 spams connection-refused warnings.
DUMP1090_ENABLED=False
#DUMP1090_URL=http://127.0.0.1:8080/data/aircraft.json

# Your home airport IATA code (e.g. LHR, ORD, JFK, SFO)
JOURNEY_CODE_SELECTED=

# Filler text shown when journey info is unknown
JOURNEY_BLANK_FILLER= ?

# Speed: "imperial" (mph), "metric" (km/h), or "knots"
SPEED_UNITS=metric

# Search radius in nautical miles from home for aircraft detection.
# If not set, computed from the bounding box (minimum 10nm).
#SEARCH_RADIUS_NM=10

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Web portal                                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘

# HTTP port for the web portal (80 = http://hostname.local with no port in the URL).
# Requires root or CAP_NET_BIND_SERVICE for ports below 1024; flightscnr runs as root.
WEB_PORT=80

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Logging & Notifications                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# Email address for alerts (leave empty to disable)
EMAIL=

# Optional map upload server for email alert links (leave empty to disable)
#MAP_UPLOAD_URL=https://your-server.example.com

# Number of farthest/closest flights to track
MAX_FARTHEST=3
MAX_CLOSEST=3

# Days of unique-callsign sightings kept in flight_counter.json (portal /stats).
# Unset or 0 keeps 7 days — unbounded growth rewrote the whole file every
# ~2s and stalled the display loop. Raise this to keep a longer history.
STATS_LOG_DAYS=7

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ AirLabs (optional — pre-departure tracked flights + flight detail routes)   │
# └─────────────────────────────────────────────────────────────────────────────┘
# Used when a tracked flight or web lookup is not yet airborne on FR24.
# Free tier: 1000 calls/month (https://airlabs.co/)
#AIRLABS_API_KEY=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ FlightAware AeroAPI (optional — route fallback only, not live radar)        │
# └─────────────────────────────────────────────────────────────────────────────┘
# Used when FR24 details and AirLabs lack origin/destination.
# Soft monthly spend ceiling protects free-tier credit (~$5/mo).
#FLIGHTAWARE_API_KEY=
#FLIGHTAWARE_MONTHLY_LIMIT=4.50
#FLIGHTAWARE_COST_PER_CALL=0.02

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ OpenSky Network (optional — further route fallback, not live radar)          │
# └─────────────────────────────────────────────────────────────────────────────┘
# Used when AirLabs and FlightAware both lack origin/destination.
# Create an API client under Account → API Client on opensky-network.org
# (separate from OPENSKY_USERNAME / OPENSKY_SERIAL feeder credentials).
# Destination is often empty while airborne — OpenSky derives routes from track
# history, not a filed flight plan.
# Can also be set via the web portal API keys section.
#OPENSKY_API_CLIENT_ID=
#OPENSKY_API_CLIENT_SECRET=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Route-enrichment source order (optional)                                    │
# └─────────────────────────────────────────────────────────────────────────────┘
# Comma-separated, tried in order, first match wins per field (gaps from one
# source are filled by the next). Omit an entry to disable it entirely.
# Valid values: airlabs, flightaware, opensky
# Default when unset: airlabs,flightaware,opensky
#
# Example — fully free/open-source, no paid API ever called:
#   ROUTE_SOURCE_ORDER=opensky
#ROUTE_SOURCE_ORDER=airlabs,flightaware,opensky

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Wildfires (CAL FIRE in California; NASA FIRMS elsewhere)                     │
# └─────────────────────────────────────────────────────────────────────────────┘
# California: no key — uses https://incidents.fire.ca.gov/umbraco/api/IncidentApi/List
# Outside CA: free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/
#FIRMS_MAP_KEY=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ ATC audio (optional — LiveATC via mpv to USB / default speaker)              │
# └─────────────────────────────────────────────────────────────────────────────┘
# Requires: sudo apt install mpv
# Prefs (enable, airport, volume, quiet hours) live in round_touch_settings.json
# via the portal ATC Audio card or Settings → ATC — not env vars.
# Optional IPC socket override for live volume while playing:
#FLIGHTSCNR_ATC_IPC=/tmp/flightscnr-atc-mpv.sock
#
# Speaker gate (ATC + hourly chime): by default a USB ALSA playback device is
# required so the Pi does not open headphones/HDMI with no usable sink.
# Temporarily allow any ALSA card (3.5 mm / HDMI), or disable the gate entirely:
#FLIGHTSCNR_AUDIO_ALLOW_BUILTIN=1
#FLIGHTSCNR_REQUIRE_SPEAKER=0

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Debug — HUD pill arrange (drag icons; no on-screen menu)                     │
# └─────────────────────────────────────────────────────────────────────────────┘
# When set, radar HUD items can be dragged on top or bottom pill; offsets persist
# in round_touch_settings.json (radar_hud_layout_top / radar_hud_layout_bottom).
# Bake arranged offsets into code defaults (no chat needed):
#   .venv/bin/python flightscnr/scripts/bake_hud_layout.py --top
# Put the value alone on the line — systemd keeps inline "# comments" in the value.
#FLIGHTSCNR_HUD_ARRANGE=1

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Lofi beats — starter playlist pack                                           │
# └─────────────────────────────────────────────────────────────────────────────┘
# The starter tracks download from a GitHub Release zip via the web portal
# (LoFi Beats). Catalog: flightscnr/assets/lofi/pack.json. Override the
# pack zip URL or id for a fork:
#LOFI_PACK_URL=https://github.com/yashmulgaonkar/FlightScnr_Pi/releases/download/lofi-pack-v1/lofi-pack.zip
#LOFI_PACK_ID=lofi-pack-v1

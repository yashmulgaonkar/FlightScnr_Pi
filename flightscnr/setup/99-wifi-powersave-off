# NetworkManager dispatcher: brcmfmac re-enables power save when wlan comes up.
# Force it off after every Wi-Fi activate so kiosk devices stay awake.

IFACE="${1:-}"
ACTION="${2:-}"

case "$ACTION" in
    pre-up|up|dhcp4-change) ;;
    *) exit 0 ;;
esac

case "$IFACE" in
    wl*|wlan*) ;;
    *) exit 0 ;;
esac

IW=""
if [ -x /usr/sbin/iw ]; then
    IW=/usr/sbin/iw
elif [ -x /sbin/iw ]; then
    IW=/sbin/iw
elif command -v iw >/dev/null 2>&1; then
    IW="$(command -v iw)"
fi

if [ -n "$IW" ]; then
    "$IW" dev "$IFACE" set power_save off >/dev/null 2>&1 || true
fi
exit 0
